FROM node:24-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

# Het schema moet er vóór npm ci staan: postinstall draait prisma generate.
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

COPY . .

EXPOSE 3000

# De broncode is een bind mount, dus src/generated komt van de host. Genereren bij
# het starten houdt de client in de container gelijk aan het schema.
CMD ["sh", "-c", "npx prisma generate && npm run dev"]
