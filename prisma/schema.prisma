// Verlofregistratie ouderschapsverlof.
//
// Alle datumvelden zijn @db.Date: een verlofdag is een kalenderdag, geen moment
// in de tijd. Dat houdt zomertijd en tijdzones buiten alle berekeningen.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PayerKind {
  EMPLOYER
  UWV
  UNPAID
}

enum DeadlineAnchor {
  WEEKS_AFTER_BIRTH
  MONTHS_AFTER_BIRTH
  YEARS_AFTER_BIRTH
  NONE
}

model Contract {
  id                 String    @id @default(cuid())
  employerName       String
  employerEmail      String
  hoursPerWeek       Decimal   @db.Decimal(5, 2)
  grossMonthlySalary Decimal   @db.Decimal(10, 2)
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplements  EmployerSupplement[]
  leaveEntries LeaveEntry[]

  @@index([startDate, endDate])
}

/// Bovenwettelijke afspraken van de werkgever. Geen rij = puur wettelijk (UWV).
model EmployerSupplement {
  id String @id @default(cuid())

  contractId  String
  leaveTypeId String

  /// Werkgever vult aan tot dit percentage van het dagloon (bv. 100).
  topUpToPercent Decimal? @db.Decimal(5, 2)
  /// Aanvulling berekend over het eigen dagloon i.p.v. het gecapte UWV-dagloon.
  topUpUncapped  Boolean  @default(true)
  /// Extra weken bovenop de wettelijke weeksMultiplier.
  extraWeeks     Decimal? @db.Decimal(5, 2)
  /// Ruimere opnametermijn dan wettelijk, in maanden na geboorte.
  deadlineOverrideMonths Int?
  notes                  String?

  contract  Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([contractId, leaveTypeId])
  @@index([leaveTypeId])
}

model Child {
  id          String   @id @default(cuid())
  name        String
  dateOfBirth DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveEntries LeaveEntry[]
}

model LeaveType {
  id   String @id @default(cuid())
  code String @unique
  name String

  /// Recht = weeksMultiplier * contract.hoursPerWeek, per kind.
  weeksMultiplier    Decimal        @db.Decimal(5, 2)
  payer              PayerKind
  payPercent         Decimal?       @db.Decimal(5, 2)
  cappedAtMaxDagloon Boolean        @default(false)
  deadlineAnchor     DeadlineAnchor
  deadlineValue      Int?

  /// Restant schuift na een verstreken deadline door naar deze verlofsoort
  /// (betaald ouderschapsverlof -> onbetaald ouderschapsverlof).
  fallbackLeaveTypeId String?
  fallbackLeaveType   LeaveType?  @relation("LeaveTypeFallback", fields: [fallbackLeaveTypeId], references: [id], onDelete: SetNull)
  fallbackForTypes    LeaveType[] @relation("LeaveTypeFallback")

  isStatutory Boolean   @default(true)
  colorHex    String?
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries     LeaveEntry[]
  supplements EmployerSupplement[]

  @@index([fallbackLeaveTypeId])
}

model LeaveEntry {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  hours Decimal  @db.Decimal(5, 2)

  childId     String
  leaveTypeId String
  /// Het contract dat gold op `date`, vastgelegd bij opslaan. Geldberekeningen
  /// lezen dit veld, nooit "het actieve contract".
  contractId  String
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  contract  Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([date, childId, leaveTypeId])
  @@index([date])
  @@index([childId, leaveTypeId])
  @@index([contractId])
  @@index([leaveTypeId])
}

/// UWV-maximumdagloon, wijzigt elke 1 januari en 1 juli. Seed-data, aanpasbaar
/// via de UI zodat een nieuwe halfjaarwaarde geen deploy vergt.
model MaxDagloon {
  id        String   @id @default(cuid())
  validFrom DateTime @unique @db.Date
  amount    Decimal  @db.Decimal(8, 2)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validFrom])
}
