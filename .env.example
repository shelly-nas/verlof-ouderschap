# Kopieer naar .env en pas aan waar nodig.

POSTGRES_USER=verlof
POSTGRES_PASSWORD=verlof
POSTGRES_DB=verlof

# Vanuit de app-container praat je met de db-service op hostnaam "db".
# Draai je npm-commando's op de host, gebruik dan localhost:5432.
DATABASE_URL=postgresql://verlof:verlof@db:5432/verlof?schema=public

TZ=Europe/Amsterdam
